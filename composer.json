{
    "name": "bluefairy/consent",
    "description": "Cookie consent banner with Google Consent Mode v2, Global Privacy Control and analytics loaded only after consent. Page-cache safe.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": { "php": ">=8.1" },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.0",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcsstandards/phpcsutils": "^1.0"
    },
    "autoload": { "psr-4": { "BlueFairy\\Consent\\": "includes/" } },
    "autoload-dev": { "psr-4": { "BlueFairy\\Consent\\Tests\\": "tests/" } },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=1G",
        "phpcs": "phpcs"
    },
    "config": { "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true } }
}
